  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::HeroSlideBookController
  panelSach: {fileID: 786167276}
  bookCanvasGroup: {fileID: 786167278}
  bookContentTransform: {fileID: 786167277}
  heroAvatarImage: {fileID: 999415851}
  heroNameText: {fileID: 1804997432}
  heroInfoText: {fileID: 820504294}
  heroAvatars:
  - {fileID: 5687653970270083563, guid: 0e3ab60b49b55214c87a40c1dd47ef5b, type: 3}
  - {fileID: -6393209325982071594, guid: 0356ef922dd5ab44fb0e7b2087deb64b, type: 3}
  - {fileID: -5710855599111037527, guid: 1e825e9a95ad5e0409364e8097b2dde7, type: 3}
  heroNames:
  - "Ki\u1EBFm S\u0129"
  - "Cung Th\u1EE7"
  - "Ph\xE1p S\u01B0"
  heroInfos:
  - "L\xE0 \u0111\u1ED9i tr\u01B0\u1EDFng c\u1EE7a \u0110\u1ED9i C\u1EADn V\u1EC7
    Ho\xE0ng Gia, Ki\u1EBFm S\u0129 \u0111\xE3 d\xE0nh c\u1EA3 cu\u1ED9c \u0111\u1EDDi
    \u0111\u1EC3 b\u1EA3o v\u1EC7 V\u01B0\u01A1ng qu\u1ED1c \xC1nh S\xE1ng. Khi Ma
    V\u01B0\u01A1ng th\u1EE9c t\u1EC9nh v\xE0 d\u1EABn qu\xE2n x\xE2m l\u01B0\u1EE3c,
    anh tr\u1EDF th\xE0nh l\xE1 ch\u1EAFn cu\u1ED1i c\xF9ng gi\u1EEFa nh\xE2n lo\u1EA1i
    v\xE0 b\xF3ng t\u1ED1i. V\u1EDBi thanh ki\u1EBFm th\xE1nh v\xE0 chi\u1EBFc khi\xEAn
    b\u1EA5t khu\u1EA5t, anh lu\xF4n x\xF4ng l\xEAn tuy\u1EBFn \u0111\u1EA7u, quy\u1EBFt
    kh\xF4ng \u0111\u1EC3 b\u1EA5t k\u1EF3 k\u1EBB \u0111\u1ECBch n\xE0o v\u01B0\u1EE3t
    qua."
  - "Sinh ra trong khu r\u1EEBng Linh M\u1ED9c, Cung Th\u1EE7 \u0111\u01B0\u1EE3c
    c\xE1c tinh linh hu\u1EA5n luy\u1EC7n t\u1EEB nh\u1ECF v\xE0 n\u1ED5i ti\u1EBFng
    v\u1EDBi kh\u1EA3 n\u0103ng b\xE1ch ph\xE1t b\xE1ch tr\xFAng. Sau khi qu\xEA
    h\u01B0\u01A1ng b\u1ECB qu\xE1i v\u1EADt t\xE0n ph\xE1, c\xF4 r\u1EDDi r\u1EEBng
    \u0111\u1EC3 t\xECm ki\u1EBFm \u0111\u1ED3ng minh ch\u1ED1ng l\u1EA1i th\u1EBF
    l\u1EF1c h\u1EAFc \xE1m. M\u1ED7i m\u0169i t\xEAn c\u1EE7a c\xF4 \u0111\u1EC1u
    mang theo s\u1EE9c m\u1EA1nh c\u1EE7a thi\xEAn nhi\xEAn, h\u1EA1 g\u1EE5c k\u1EBB
    th\xF9 t\u1EEB kho\u1EA3ng c\xE1ch xa tr\u01B0\u1EDBc khi ch\xFAng k\u1ECBp ti\u1EBFp
    c\u1EADn."
  - "Ph\xE1p S\u01B0 l\xE0 h\u1ECDc gi\u1EA3 cu\u1ED1i c\xF9ng c\u1EE7a Th\xE1p Tinh
    T\xFA c\u1ED5 \u0111\u1EA1i, n\u01A1i l\u01B0u gi\u1EEF nh\u1EEFng ph\xE9p thu\u1EADt
    \u0111\xE3 th\u1EA5t truy\u1EC1n. Khi phong \u1EA5n c\u1ED5 x\u01B0a b\u1ECB
    ph\xE1 v\u1EE1, \xF4ng b\u01B0\u1EDBc ra kh\u1ECFi nhi\u1EC1u n\u0103m \u1EA9n
    d\u1EADt \u0111\u1EC3 ng\u0103n ch\u1EB7n ma thu\u1EADt h\u1EAFc \xE1m lan r\u1ED9ng
    kh\u1EAFp th\u1EBF gi\u1EDBi. V\u1EDBi c\xE2y tr\u01B0\u1EE3ng pha l\xEA v\xE0
    ngu\u1ED3n ma l\u1EF1c v\xF4 t\u1EADn, \xF4ng tri\u1EC7u h\u1ED3i nh\u1EEFng
    ph\xE9p thu\u1EADt h\u1EE7y di\u1EC7t \u0111\u1EC3 b\u1EA3o v\u1EC7 v\u01B0\u01A1ng
    qu\u1ED1c v\xE0 d\u1EABn d\u1EAFt c\xE1c anh h\xF9ng \u0111\u1EBFn chi\u1EBFn
    th\u1EAFng."
